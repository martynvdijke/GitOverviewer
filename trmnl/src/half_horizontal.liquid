<div class="layout layout--col layout--stretch gap--xsmall">
  <div class="title_bar">
    <img class="image" width="32" src="{{ trml.plugin_settings.custom_fields_values.url | default: 'https://gitlens.vandijke.xyz' }}/static/logo.svg" />
    <span class="title">GitLens</span>
  </div>

  <div class="grid grid--cols-2">
    <div class="col col--start">
      <div class="item">
        <span class="value value--medium">{{ total_releases | default: 0 }}</span>
        <span class="label label--small">releases</span>
      </div>
      <div class="item">
        <span class="value value--medium">{{ workflow_pass_rate | default: 0 }}%</span>
        <span class="label label--small">pass rate</span>
      </div>
    </div>
    <div class="col col--start">
      <div class="item">
        <span class="value value--medium">{{ failing_repos | default: 0 }}</span>
        <span class="label label--small">failing</span>
      </div>
      <div class="item">
        <span class="value value--medium">{{ total_repos | default: 0 }}</span>
        <span class="label label--small">repos</span>
      </div>
    </div>
  </div>

  <div class="divider--h"></div>

  <span class="label label--small">Failing repos</span>
  {% if failing_repo_list.size > 0 %}
    <div class="item">
      <span class="value value--xsmall">{{ failing_repos }} repo{% if failing_repos != 1 %}s{% endif %} · {{ failing_repo_list[0].workflow_status }}</span>
    </div>
  {% else %}
    <span class="value value--xsmall">All clear</span>
  {% endif %}
</div>
