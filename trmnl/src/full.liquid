<div class="layout layout--col gap--small">
  <div class="title_bar">
    <img class="image" width="40" src="{{ trml.plugin_settings.custom_fields_values.url | default: 'https://gitlens.vandijke.xyz' }}/static/logo.svg" />
    <span class="title">GitLens{% if IDX_0.generated_at %} · {{ IDX_0.generated_at | date: "%b %d" }}{% endif %}</span>
  </div>

  <div class="grid grid--cols-2">
    <div class="col col--start">
      <div class="item">
        <span class="value value--large">{{ IDX_0.total_repos | default: 0 }}</span>
        <span class="label label--small">repos</span>
      </div>
      <div class="item">
        <span class="value value--large">{{ IDX_0.total_releases | default: 0 }}</span>
        <span class="label label--small">releases</span>
      </div>
    </div>
    <div class="col col--start">
      <div class="item">
        <span class="value value--large">{{ IDX_0.failing_repos | default: 0 }}</span>
        <span class="label label--small">failing</span>
      </div>
      <div class="item">
        <span class="value value--large">{{ IDX_0.workflow_pass_rate | default: 0 }}%</span>
        <span class="label label--small">pass rate</span>
      </div>
    </div>
  </div>

  <div class="divider--h"></div>

  <div class="grid grid--cols-2">
    <div class="col col--start">
      <span class="label label--small">Latest releases</span>
      {% if IDX_0.latest_releases.size > 0 %}
        {% for release in IDX_0.latest_releases limit: 4 %}
          <div class="item">
            <span class="content">{{ release.full_name }}</span>
            <span class="value value--xsmall">{{ release.tag }}</span>
          </div>
        {% endfor %}
      {% else %}
        <span class="value value--xsmall">—</span>
      {% endif %}
    </div>
    <div class="col col--start">
      <span class="label label--small">Failing repos</span>
      {% if IDX_0.failing_repo_list.size > 0 %}
        {% for repo in IDX_0.failing_repo_list limit: 4 %}
          <div class="item">
            <span class="content">{{ repo.full_name }}</span>
            <span class="value value--xsmall">{{ repo.workflow_status }}</span>
          </div>
        {% endfor %}
      {% else %}
        <span class="value value--xsmall">All clear</span>
      {% endif %}
    </div>
  </div>
</div>
